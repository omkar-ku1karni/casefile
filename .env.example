# Copy to .env. Every key is optional: with none set, use `--oracle` (mechanics demo) or a local Ollama.

# LLM providers
GEMINI_API_KEY=            # https://aistudio.google.com/apikey
GROQ_API_KEY=              # https://console.groq.com/keys

# Tracing (optional). Langfuse Cloud, or point LANGFUSE_HOST at a self-hosted Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Use an external Postgres instead of the embedded one (docker compose sets this for you)
# DATABASE_URL=postgresql://casefile:casefile@localhost:5432/casefile

# Local model fallback
# OLLAMA_HOST=http://localhost:11434
